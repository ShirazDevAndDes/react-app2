# ==============================================================================
# Domain & Traefik Configuration
# ==============================================================================

# REPLACE THIS with your actual domain or subdomain (e.g. app.example.com or example.com)
APP_DOMAIN=srv1011002.hstgr.cloud

# The name of your Traefik network on your VPS (common names: traefik-public, traefik_network, web, proxy)
TRAEFIK_NETWORK=traefik-public

# The certificate resolver defined in your Traefik configuration (commonly: letsencrypt, le, myresolver)
CERT_RESOLVER=letsencrypt
